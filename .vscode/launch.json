{
	"version": "0.2.0",
	"configurations": [
		{
ugly			"name": "Chora",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}\\scripts\\StartMode.mjs",
			"args": ["copilot-relay"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"autoAttachChildProcesses": true,
			"outFiles": [
				"${workspaceFolder}/.vite/build/**/*.js",
				"${workspaceFolder}/tools/copilot-relay/dist/**/*.js"
			],
			"skipFiles": [
				"<node_internals>/**"
			]
		}
	]
}
