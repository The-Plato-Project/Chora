{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Chora",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "${env:LOCALAPPDATA}\\Programs\\nodejs\\node.exe",
			"program": "${workspaceFolder}\\scripts\\StartMode.mjs",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"env": {
				"PATH": "${env:LOCALAPPDATA}\\Programs\\nodejs;${env:PATH}"
			},
			"autoAttachChildProcesses": true,
			"outFiles": [
				"${workspaceFolder}/.vite/build/**/*.js"
			],
			"skipFiles": [
				"<node_internals>/**"
			]
		},
		{
			"name": "Chora (PATH)",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}\\scripts\\StartMode.mjs",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"autoAttachChildProcesses": true,
			"outFiles": [
				"${workspaceFolder}/.vite/build/**/*.js"
			],
			"skipFiles": [
				"<node_internals>/**"
			]
		}
	]
}
