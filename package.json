{
	"name": "chora",
	"version": "0.1.0",
	"private": true,
	"description": "Chora — A reading and writing environment for Plato.",
	"main": ".vite/build/src/main/main.js",
	"scripts": {
		"postinstall": "node scripts/FixMilkdownDeclarations.mjs",
		"start": "node scripts/StartMode.mjs",
		"dev:platosi": "node scripts/StartMode.mjs",
		"package": "npm run build && electron-forge package",
		"make": "npm run build && electron-forge make",
		"build": "npm run build:main && npm run build:preload && npm run build:renderer",
		"build:main": "tsc -p tsconfig.main.json",
		"build:preload": "node scripts/BuildPreload.mjs",
		"build:renderer": "node scripts/BuildRenderer.mjs",
		"typecheck": "tsc -p tsconfig.main.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@milkdown/kit": "^7.22.1",
		"electron-squirrel-startup": "^1.0.1",
		"gray-matter": "^4.0.3",
		"lucide": "^1.41.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.6.0",
		"@electron-forge/maker-deb": "^7.6.0",
		"@electron-forge/maker-rpm": "^7.6.0",
		"@electron-forge/maker-squirrel": "^7.6.0",
		"@electron-forge/maker-zip": "^7.6.0",
		"@types/node": "^24.0.0",
		"electron": "^37.0.0",
		"happy-dom": "^20.14.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	}
}
